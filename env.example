# Google Sheets 目標試算表 ID
SHEETS_SPREADSHEET_ID=

# 電子發票開放資料 API 基底網址（可留空使用預設）
EINV_BASE_URL=https://www.einvoice.nat.gov.tw/portal/ods/ODS318E/einvoice_open_data

# 本機開發若需使用服務帳戶檔案，可設置 GOOGLE_APPLICATION_CREDENTIALS 指向金鑰 JSON
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# 也可直接提供 JSON 內容（優先於檔案路徑）：
# 將服務帳戶 JSON 內容貼入此變數（注意私鑰換行需保留）
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}

# 或提供 base64 編碼版本：
# GOOGLE_APPLICATION_CREDENTIALS_B64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Ii4uLn0=


